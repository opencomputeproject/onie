gptfdisk ONIE cross compile patch

Copyright (C) 2014 Curt Brune <curt@cumulusnetworks.com>

SPDX-License-Identifier:     GPL-2.0

Small modifications to the gptfdisk Makefile for cross compiling in
the ONIE build environment.

Main changes:

- prefix gcc and g++ with $(CROSS_COMPILE)
- append $(ONIE_CXXFLAGS) and $(ONIE_LDFLAGS)

Note: as of gptfdisk 1.0.10 the default Linux build no longer enables
Unicode (USE_UTF16) or links against ICU (-licuio -licuuc), so those
removals from earlier versions are no longer necessary.

diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..61758e7
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,2 @@
+gdisk
+sgdisk
diff --git a/Makefile b/Makefile
index af9701c..2c46185 100644
--- a/Makefile
+++ b/Makefile
@@ -64,6 +64,8 @@ endif
 $(info Build target is $(TARGET))
 
 # Default/Linux settings....
+CC=$(CROSS_COMPILE)gcc
+CXX=$(CROSS_COMPILE)g++
 STRIP?=strip
 #CXXFLAGS+=-O2 -Wall -D_FILE_OFFSET_BITS=64 -D USE_UTF16
 CXXFLAGS+=-O2 -Wall -D_FILE_OFFSET_BITS=64
@@ -142,6 +144,9 @@ LIB_HEADERS=$(LIB_NAMES:=.h)
 DEPEND= makedepend $(CXXFLAGS)
 ALL_EXE=$(ALL:=$(FN_EXTENSION))
 
+CXXFLAGS+= $(ONIE_CXXFLAGS)
+LDFLAGS+= $(ONIE_LDFLAGS)
+
 all:	$(ALL)
 
 gdisk:	$(LIB_OBJS) gdisk.o gpttext.o
