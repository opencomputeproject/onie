diff --git a/Makefile b/Makefile
index 5ac8a59..566bc2a 100644
--- a/Makefile
+++ b/Makefile
@@ -24,9 +24,9 @@ INSTALL_PROGRAM	:= $(INSTALL) -m 755
 LN		:= ln -sf
 RM		:= rm -f

-CC	?= gcc
-AR	?= ar
-STRIP	?= strip
+CC	= $(CROSS_COMPILE)gcc
+AR	= $(CROSS_COMPILE)ar
+STRIP	= $(CROSS_COMPILE)strip

 CFLAGS		?= -O2
 # When debugging, use the following instead
@@ -34,9 +34,9 @@ CFLAGS		?= -O2
 CFLAGS		+= -Wall
 SOCFLAGS	:= -fpic -D_REENTRANT $(CFLAGS)

-BUILD_DYNAMIC_LIB ?= 1
+BUILD_DYNAMIC_LIB ?= 0
 BUILD_STATIC_LIB ?= 1
-USE_STATIC_LIB ?= 0
+USE_STATIC_LIB ?= 1

 ifeq ($(USE_STATIC_LIB),1)
 BUILD_STATIC_LIB := 1
@@ -54,7 +54,5 @@ endif

 all:

-EXTRA	:=
-#EXTRA	+= eeprog py-smbus
-SRCDIRS	:= include lib eeprom stub tools $(EXTRA)
+SRCDIRS	:= include lib
 include $(SRCDIRS:%=%/Module.mk)
