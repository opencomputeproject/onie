+static int d6_find_ll_ip(const char *ifname, struct in6_addr *ll_ip)
+{
+	FILE *fp = fopen("/proc/net/if_inet6", "r");
+	char addr_str[33];
+	int idx, plen, scope, flags;
+	char devname[20];
+
+	if (!fp) return -1;
+
+	while (fscanf(fp, "%32s %x %x %x %x %19s\n", addr_str, &idx, &plen, &scope, &flags, devname) == 6) {
+		if (strcmp(devname, ifname) == 0 && scope == 0x20) {
+			/* Found it. Parse addr_str. */
+			int i;
+			uint8_t *p = (uint8_t*)ll_ip;
+			for (i = 0; i < 16; i++) {
+				unsigned int val;
+				sscanf(addr_str + i*2, "%02x", &val);
+				p[i] = val;
+			}
+			fclose(fp);
+			return 0;
+		}
+	}
+	fclose(fp);
+	return -1;
+}
