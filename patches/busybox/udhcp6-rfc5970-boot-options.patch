+
 /* Initialize the packet with the proper defaults */
 static uint8_t *init_d6_packet(struct d6_packet *packet, char type, uint32_t xid)
 {
 	struct d6_option *clientid;
+	struct option_set *user_clientid;
 
 	memset(packet, 0, sizeof(*packet));
 
 	packet->d6_xid32 = xid;
 	packet->d6_msg_type = type;
 
+	user_clientid = find_user_clientid_option();
+	if (user_clientid && user_clientid->data[OPT_LEN] >= 2) {
+		return packet->d6_options;
+	}
+	if (user_clientid)
+		bb_error_msg("ignoring malformed DHCPv6 client-id from -x 1 (len=%u), falling back to default", user_clientid->data[OPT_LEN]);
+
 	clientid = (void*)client_config.clientid;
 	return d6_store_blob(packet->d6_options, clientid, clientid->len + 2+2);
 }
 
