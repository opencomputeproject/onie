+static void d6_alloc_vendor_option(const char *str)
+{
+	unsigned len;
+	uint8_t *opt;
+	uint32_t enterprise = 0;
+	char *colon = strchr(str, ':');
+
+	if (colon) {
+		char *end;
+		enterprise = strtoul(str, &end, 0);
+		if (end == colon) {
+			str = colon + 1;
+		} else {
+			enterprise = 0;
+		}
+	}
+
+	len = strlen(str);
+	/* Option 16: code(2) + len(2) + enterprise(4) + [chunk_len(2) + data] */
+	opt = xzalloc(4 + 4 + 2 + len);
+	opt[1] = D6_OPT_VENDOR_CLASS;
+	opt[2] = 0;
+	opt[3] = 4 + 2 + len;
+	opt[4] = (enterprise >> 24);
+	opt[5] = (enterprise >> 16);
+	opt[6] = (enterprise >> 8);
+	opt[7] = enterprise;
+	opt[8] = 0;
+	opt[9] = len;
+	memcpy(opt + 10, str, len);
+	client_config.vendorclass = opt;
+}
 
