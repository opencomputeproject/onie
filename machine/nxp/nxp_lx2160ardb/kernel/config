# LX2160ARDB additions to ONIE's arm64 kernel config
# DPAA2 Ethernet (ONIE networking over the DPMACs) and the RGMII PHYs
CONFIG_FSL_DPAA2_ETH=y
CONFIG_FSL_DPAA2_PTP_CLOCK=n
CONFIG_AT803X_PHY=y
# FlexSPI NOR: U-Boot env, system EEPROM partition, ONIE updates
CONFIG_SPI=y
CONFIG_SPI_NXP_FLEXSPI=y
# MT35XU512: 128 KiB erase blocks only
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
# SBSA watchdog, SA56004 temperature sensors
CONFIG_ARM_SBSA_WATCHDOG=y
CONFIG_SENSORS_LM90=y
# PCIe host (NVMe boot disks, PCIe devices): LX2160A rev2 uses the
# DesignWare-based controller, rev1 the Mobiveil-based one
CONFIG_PCI_LAYERSCAPE=y
CONFIG_PCIE_LAYERSCAPE_GEN4=y
