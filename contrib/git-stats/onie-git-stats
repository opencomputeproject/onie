# Generate git repo statistics based on git commit ranges

exe=$(basename $0)
usage() {
    echo "Usage: $exe <git-range> <output-prefix>"
    echo "example: $exe 2018.02..HEAD quarterly"
    echo "example: $exe 2017.02..2018.02 yearly"
}

if [ -n "$1" ] ; then
    range="$1"
else
    echo "Error: expecting a range in the form of a git revision range"
    usage
    exit 1
fi
shift 1

if [ -n "$1" ] ; then
    prefix="$1"
else
    echo "Error: expecting output file prefix"
    usage
    exit 1
fi

# gitdm executable.
#
# gitdm is no longer vendored in this tree.  Unless $GITDM already points
# at a usable gitdm, auto-install a python3 port of gitdm (pinned) into a
# local, git-ignored cache directory and run that.  Override the source
# with $GITDM_REPO / $GITDM_REF, or set $GITDM to use your own copy.
GITDM_REPO="${GITDM_REPO:-https://github.com/OSSystems/gitdm.git}"
GITDM_REF="${GITDM_REF:-b7b1f8e7d567fc41dcfc249de5e967a6a30aa9b5}"

script_dir="$(dirname "$(realpath "$0")")"

if [ -z "$GITDM" ] ; then
    gitdm_dir="$script_dir/.gitdm"
    GITDM="$gitdm_dir/gitdm"
    if [ ! -e "$GITDM" ] ; then
        command -v git >/dev/null 2>&1 || {
            echo "Error: git is required to auto-install gitdm"
            exit 1
        }
        echo "gitdm not found -- installing python3 gitdm from $GITDM_REPO@$GITDM_REF ..."
        rm -rf "$gitdm_dir"
        git clone -q "$GITDM_REPO" "$gitdm_dir" || {
            echo "Error: failed to clone gitdm from $GITDM_REPO"
            exit 1
        }
        git -C "$gitdm_dir" checkout -q "$GITDM_REF" || {
            echo "Error: failed to check out gitdm $GITDM_REF"
            rm -rf "$gitdm_dir"
            exit 1
        }
    fi
fi
[ -e "$GITDM" ] || {
    echo "Error: Unable to find gitdm ($GITDM)"
    exit 1
}

command -v python3 >/dev/null 2>&1 || {
    echo "Error: python3 is required to run gitdm"
    exit 1
}

# gitdm configuration
if [ -z "$GITDM_CFG_DIR" ] ; then
    GITDM_CFG_DIR="$script_dir/gitdm-config"
fi
[ -d "$GITDM_CFG_DIR" ] || {
    echo "Error: Unable to find gitdm configuration directory"
    exit 1
}

echo "Using gitdm exe: $GITDM"
echo "Using gitdm config directory: $GITDM_CFG_DIR"

gitdm_cfg="/tmp/${prefix}-gitdm.cfg"
cat<<EOF > $gitdm_cfg
#
# EmailAliases lets us cope with developers who use more
# than one address.
#
EmailAliases $GITDM_CFG_DIR/aliases

#
# EmailMap does the main work of mapping addresses onto
# employers.
#
EmailMap $GITDM_CFG_DIR/domain-map

#
# Use GroupMap to map a file full of addresses to the
# same employer
#
# GroupMap sample-config/illuminati  The Illuminati
#
#
# Use FileTypeMap to map a file types to file names using regular
# regular expressions.
#
FileTypeMap $GITDM_CFG_DIR/filetypes.txt
EOF

output_txt="/tmp/${prefix}-results.txt"
output_html="/tmp/${prefix}-results.html"

echo "Generating stats for range: $range ..."
# PYTHONWARNINGS: the pinned upstream gitdm trips python3 SyntaxWarnings for
# unescaped regex sequences in its own source; silence that upstream noise.
git log -p -M "$range" | \
    PYTHONWARNINGS="ignore::SyntaxWarning" python3 "$GITDM" \
           -o "$output_txt" \
           -h "$output_html" \
           -c "$gitdm_cfg"

echo "Stats available here:"
echo "  $output_txt"
echo "  $output_html"
